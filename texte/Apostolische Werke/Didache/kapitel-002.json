  "footnotes": [
    {
      "id": "5f028af3-b478-45c8-6c8a-08deca2b5965",
      "kind": "EditorialNote",
      "position": 1,
      "bodyMarkdown": "„Knaben nicht verderben“ gibt das griechische paidophthorēseis wieder, also der sexuellen Verderbung von Knaben."
    },
    {
      "id": "2f7a65bc-cea6-446b-1410-08deca2e86c5",
      "kind": "EditorialNote",
      "position": 2,
      "bodyMarkdown": "Die frühchristliche Verwerfung von Abtreibung und Kindestötung ist offensichtlich keine spätere kirchliche Entwicklung. Die Didache stellt das ungeborene und das geborene Kind unter das Tötungsverbot: Abtreibungsmittel, Kindsaussetzung und direkte Kindestötung waren auch schon in der Antike bekannt."
    }
  ]
