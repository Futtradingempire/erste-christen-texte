                }
              }
            ]
          },
          {
            "type": "text",
            "text": " in ",
            "marks": [
              {
                "type": "lexiconQuoteLink",
                "attrs": {
                  "id": "6d12179f-5d3d-4540-c136-08decade64a0"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": "dein Reich, das du ihr bereitet hast",
            "marks": [
              {
                "type": "biblePassageLink",
                "attrs": {
                  "id": "5564dad1-325e-4c8a-9f52-90b5c6a76577"
                }
              },
              {
                "type": "lexiconQuoteLink",
