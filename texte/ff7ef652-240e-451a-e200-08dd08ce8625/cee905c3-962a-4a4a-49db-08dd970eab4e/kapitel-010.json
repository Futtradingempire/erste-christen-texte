                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". Denn dein ist die Macht und die Herrlichkeit in Ewigkeit. ",
            "marks": [
              {
                "type": "lexiconQuoteLink",
                "attrs": {
                  "id": "6d12179f-5d3d-4540-c136-08decade64a0"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": "Es komme die Gnade",
            "marks": [
              {
                "type": "biblePassageLink",
                "attrs": {
