              {
                "type": "lexiconQuoteLink",
                "attrs": {
                  "id": "f68c0063-a2cc-437a-4bf5-08debeedc7b6"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": "„Den ganzen Tag habe ich meine Hände ausgebreitet zu einem Volk, das nicht glaubt und das mir widerspricht.“",
