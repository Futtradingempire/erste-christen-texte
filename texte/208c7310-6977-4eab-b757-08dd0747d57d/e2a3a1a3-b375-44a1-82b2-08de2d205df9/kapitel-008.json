          },
          {
            "type": "text",
            "text": "„der in die unteren Teile der Erde hinabstieg“",
            "marks": [
              {
                "type": "biblePassageLink",
                "attrs": {
                  "id": "8a5d5f8d-0c29-4ca5-a40f-5eb769525774"
