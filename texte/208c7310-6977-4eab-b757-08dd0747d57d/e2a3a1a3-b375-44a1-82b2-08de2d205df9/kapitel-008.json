              {
                "type": "biblePassageLink",
                "attrs": {
                  "id": "13c67dc5-d9e0-42ce-b01e-396380b42940"
                }
              },
              {
                "type": "lexiconQuoteLink",
                "attrs": {
                  "id": "f68c0063-a2cc-437a-4bf5-08debeedc7b6"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " Sie werden euch also auf keine andere Weise fürchten, noch ",
            "marks": [
              {
                "type": "lexiconQuoteLink",
                "attrs": {
                  "id": "f68c0063-a2cc-437a-4bf5-08debeedc7b6"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": "„wird der Schrecken vor euch über sie kommen,“",
            "marks": [
              {
                "type": "biblePassageLink",
                "attrs": {
                  "id": "eb6d3542-82ff-4c40-9348-67943a270ba4"
                }
              },
